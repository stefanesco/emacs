;;; custom.el --- Customize-managed settings -*- lexical-binding: t; -*-
;; Emacs writes to this file automatically.  package.el will re-populate
;; package-selected-packages as use-package installs things, so we no longer
;; pin it to nil (which used to make M-x package-autoremove target everything).
(custom-set-variables
 ;; custom-set-variables was added by Custom.
 ;; If you edit it by hand, you could mess it up, so be careful.
 ;; Your init file should contain only one such instance.
 ;; If there is more than one, they won't work right.
 '(package-selected-packages nil))
(custom-set-faces
 ;; custom-set-faces was added by Custom.
 ;; If you edit it by hand, you could mess it up, so be careful.
 ;; Your init file should contain only one such instance.
 ;; If there is more than one, they won't work right.
 )
